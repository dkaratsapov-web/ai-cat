# Скопируйте в .env и заполните. Никогда не коммитьте .env и не пересылайте ключи в переписке.

# Kling AI: https://kling.ai/dev/api-key
# Основной способ — API Key (работает для всех моделей):
KLING_API_KEY=
# Альтернатива для API «старого» стандарта — пара Access Key + Secret Key (подписывается в JWT):
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Базовый URL API. Глобальная платформа — см. docs/INTEGRATIONS.md
KLING_API_BASE=https://api-singapore.klingai.com

# Yandex SpeechKit (основная озвучка): консоль Yandex Cloud → сервисный аккаунт с ролью ai.speechkit-tts.user → API-ключ
YANDEX_API_KEY=
# Только для входа по IAM-токену. С API-ключом ОСТАВЬТЕ ПУСТЫМ (не путать с ID сервисного аккаунта)
YANDEX_FOLDER_ID=
# Голос по умолчанию, если не задан в config/voices.yaml (например: filipp, ermil, zahar, alena, jane)
YANDEX_VOICE=

# ElevenLabs (альтернатива, https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Hedra (опционально)
# Higgsfield API (open.higgsfield.ai → API keys): ключ и секрет — две части
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HEDRA_API_KEY=

# Runway (опционально)
RUNWAYML_API_SECRET=

# OpenAI (контент-директор, Director Bridge): platform.openai.com → Project → API keys (лучше service account).
# Оплачивается отдельно от подписки ChatGPT. Проверка: studio director ping
OPENAI_API_KEY=

# Telegram-бот (docs/BOT.md): токен от @BotFather и ваш числовой ID (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Claude-продюсер в боте: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Необязательно: свой постоянный адрес мини-приложения (иначе бот поднимает туннель cloudflared сам)
MINIAPP_URL=
# Необязательно: свои боты агентов (своя аватарка в группе команды, docs/BOT.md)
TELEGRAM_CLAUDE_BOT_TOKEN=
TELEGRAM_DIRECTOR_BOT_TOKEN=

# Сбер SaluteSpeech (озвучка): developers.sber.ru → проект SaluteSpeech API → «Ключ авторизации» (Authorization key)
SALUTE_AUTH_KEY=
# SALUTE_SPEECH_PERS — физлицо (по умолчанию), SALUTE_SPEECH_CORP — юрлицо/ИП
SALUTE_SCOPE=
